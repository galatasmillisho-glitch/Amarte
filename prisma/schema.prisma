generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id         String   @id @default(cuid())
  userId     String
  latitude   Float
  longitude  Float
  accuracy   Float?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model LocationShare {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([token])
}